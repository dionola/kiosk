// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  image     String?
  sequence  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MenuItem[]

  @@index([sequence])
}

model MenuItem {
  id               String   @id @default(cuid())
  categoryId       String?
  sourceItemId     String?
  sourceCategoryId String?
  name             String
  description      String?
  price            Float
  image            String?
  available        Boolean  @default(true)
  sequence         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])

  // Mapping to available customizations
  customizations MenuItemCustomization[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([sequence])
  @@index([sourceCategoryId])
  @@index([sourceItemId])
}

// Standalone table for customization options (e.g. "Large Coke Zero", "Spicy Chicken")
model CustomizationItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float    @default(0)
  image       String?
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Many-to-many relationship with MenuItems via mapping table
  mappings MenuItemCustomization[]
}

// Mapping table to describe which customizations apply to which menu items
model MenuItemCustomization {
  id                  String @id @default(cuid())
  menuItemId          String
  customizationItemId String
  group               String @default("Options") // e.g. "Drink", "Side", "Chicken Type"
  sequence            Int    @default(0)

  menuItem          MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  customizationItem CustomizationItem @relation(fields: [customizationItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, customizationItemId])
  @@index([menuItemId])
  @@index([customizationItemId])
  @@index([sequence])
}

model Order {
  id        String   @id @default(cuid())
  userId    String? // Optional for guest orders
  status    String   @default("pending") // pending, confirmed, preparing, ready, completed, cancelled
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  menuItemId     String
  quantity       Int
  customizations String? // JSON string (SQLite connector doesn't support Json)
  price          Float
  createdAt      DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
}

model Cart {
  id        String   @id @default(cuid())
  sessionId String   @unique
  items     String // JSON string (SQLite connector doesn't support Json)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
}
